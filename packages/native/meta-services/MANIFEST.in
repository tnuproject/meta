name: meta-services
origin: meta/meta-services
version: "@VERSION@"
comment: "META D-Bus services"
desc: "meta-netd, a NetworkManager-compatible service, and metaupdd, the update service."
maintainer: "packages@meta.invalid"
www: "https://github.com/tnuproject/meta"
categories: [sysutils]
licenselogic: single
