# Maintainer: The META Project <packages@meta.invalid>
# Identifies and protects a META Arch Edition compatibility root.
pkgname=meta-compat-environment
pkgver=26.0dev0
pkgrel=1
pkgdesc='Identifies a META compatibility root'
arch=('any')
url='https://github.com/tnuproject/meta'
license=('BSD-2-Clause')
backup=('etc/meta-compat-release')
source=('meta-compat.hook' 'meta-compat-release' 'LICENSE')
sha256sums=('SKIP' 'SKIP' 'SKIP')

package() {
  install -Dm644 meta-compat.hook "$pkgdir/usr/share/libalpm/hooks/00-meta-compat.hook"
  install -Dm644 meta-compat-release "$pkgdir/etc/meta-compat-release"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
