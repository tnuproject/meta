// META's Fastfetch configuration.
//
// Fastfetch picks a logo from os-release. META's own ID has no logo, so the
// built-in FreeBSD logo is selected by name. Do not replace it.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "source": "freebsd"
  }
}
