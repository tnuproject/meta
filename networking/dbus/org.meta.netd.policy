<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
  "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>The META Project</vendor>
  <vendor_url>https://github.com/tnuproject/meta</vendor_url>
  <!-- NetworkManager's own action name, so existing administrator rules apply. -->
  <action id="org.freedesktop.NetworkManager.network-control">
    <description>Connect and disconnect networks</description>
    <message>Authentication is needed to change network connections</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin_keep</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>
</policyconfig>
