# Template for a compatibility root as a jail. Status: PLANNED.
#
# @EDITION@ is "debian" or "arch". The root is the edition's root from
# packages/editions. Checked for syntax with jail -e; not yet used by any tool.
meta_@EDITION@ {
	path = "/compat/meta/@EDITION@";
	host.hostname = "meta-@EDITION@";
	ip4 = inherit;
	ip6 = inherit;
	linux = new;
	linux.osname = "Linux";
	enforce_statfs = 1;
	children.max = 0;
	mount.devfs;
	devfs_ruleset = 4;
	persist;
}
